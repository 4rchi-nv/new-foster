# Copy to /etc/new-foster.env on the VPS. Do not commit the filled file.
# Mode 600, owner root, group the service user.

NODE_ENV=production

# openssl rand -base64 48
PAYLOAD_SECRET=

# Public origin, no trailing slash. Rebuild after changing this.
NEXT_PUBLIC_SITE_URL=https://newfoster.example

# Persistent SQLite file. The directory must exist and be writable by the service user.
DATABASE_URL=file:/var/lib/new-foster/database/payload.db

# Absolute upload directories. Omit these locally to keep ./media and ./media/documents.
MEDIA_DIR=/var/lib/new-foster/media
DOCUMENTS_DIR=/var/lib/new-foster/documents
# Old inquiry files only. The public site does not accept new inquiries.
INQUIRY_DIR=/var/lib/new-foster/inquiries

# First editor. Used only when the users collection is empty. Leave blank after the account exists.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Optional. ga4 or ym. Nothing loads until both are set, and only after consent.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
