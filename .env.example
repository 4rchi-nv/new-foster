# Copy to .env.local. Do not commit real secrets.

PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local: file database next to the app.
DATABASE_URL=file:./data/payload.db
# DATABASE_AUTH_TOKEN=

# Vercel / remote (Turso LibSQL). Example:
# DATABASE_URL=libsql://your-db-name-org.turso.io
# DATABASE_AUTH_TOKEN=eyJ...
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# First editor account. Used only when the users collection is empty.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# Optional. Inquiries are saved in the CMS even when SMTP is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
INQUIRY_TO=

# Optional. ga4 or ym. Nothing loads until both values are set, and only after consent.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_ID=
